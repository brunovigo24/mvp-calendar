{
  "name": "agendabot",
  "version": "1.0.0",
  "description": "Bot de agendamento via Telegram integrado ao Google Calendar",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "start": "node dist/index.js",
    "migrate": "cat src/db/migrations/001_initial.sql | docker exec -i mvp-calendar-postgres-1 psql -U user -d agendabot",
    "oauth:setup": "tsx scripts/oauth-setup.ts"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "googleapis": "^144.0.0",
    "bullmq": "^5.12.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "tsup": "^8.2.4"
  }
}
